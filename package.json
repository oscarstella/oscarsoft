{
  "name": "oscarsoft-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "npm --prefix client run dev",
    "server:dev": "node --watch server/index.js",
    "client:build": "npm --prefix client run build",
    "start": "node server/index.js",
    "install:all": "npm --prefix client install && npm --prefix server install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
